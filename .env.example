NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/truthsync
SYNC_ADMIN_TOKEN=change-me
DEMO_MODE=true

# HubSpot private app token
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CURRENCY=usd

# Google OAuth client with Calendar API enabled and a refresh token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Stripe test-mode secret key
STRIPE_SECRET_KEY=

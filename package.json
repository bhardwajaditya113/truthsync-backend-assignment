{
  "name": "truthsync-backend-assignment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --import tsx scripts/migrate.ts",
    "seed:demo": "node --import tsx scripts/seed-demo.ts",
    "seed:hubspot": "node --import tsx scripts/seed-hubspot.ts",
    "seed:stripe": "node --import tsx scripts/seed-stripe.ts",
    "seed:calendar": "node --import tsx scripts/seed-google-calendar.ts",
    "sync:once": "node --import tsx scripts/sync-once.ts",
    "verify:db": "node --import tsx scripts/verify-db.ts",
    "demo:live": "node --import tsx scripts/demo-live.ts",
    "demo:failure": "node --import tsx scripts/demo-failure.ts"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "stripe": "^18.5.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
